# Copy this file to .env and fill in your values.

# Email via Gmail SMTP (free). Needs a Google App Password: https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
# Where to send alerts (defaults to SMTP_USER)
EMAIL_TO=

# Alert when an index is down this many percent or more from the previous close
DIP_THRESHOLD_PCT=1.0

# How often to check prices when running locally, in seconds
CHECK_INTERVAL_SECONDS=300

# Indexes to track: comma-separated Yahoo Finance symbol=Name pairs
INDEXES=^GSPC=S&P 500,^IXIC=Nasdaq Composite,^DJI=Dow Jones,^RUT=Russell 2000,^NSEI=Nifty 50,^BSESN=Sensex,^FTSE=FTSE 100,^N225=Nikkei 225
