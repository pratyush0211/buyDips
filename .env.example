# Copy this file to .env and fill in your values.

# WhatsApp provider: meta, callmebot or twilio
WHATSAPP_PROVIDER=meta
# Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
META_ACCESS_TOKEN=your_access_token
META_PHONE_NUMBER_ID=
META_TO=10000000000
# hello_world for the first test; switch to buydips_alert once that template is approved
META_TEMPLATE_NAME=hello_world
META_TEMPLATE_LANG=en_US

# CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_PHONE=+10000000000
CALLMEBOT_APIKEY=your_api_key

# Twilio WhatsApp credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Twilio sandbox number by default; replace with your approved sender in production
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your phone number, with country code
WHATSAPP_TO=whatsapp:+10000000000

# Alert when an index is down this many percent or more from the previous close
DIP_THRESHOLD_PCT=1.0

# How often to check prices, in seconds
CHECK_INTERVAL_SECONDS=300

# Indexes to track: comma-separated Yahoo Finance symbol=Name pairs
INDEXES=^GSPC=S&P 500,^IXIC=Nasdaq Composite,^DJI=Dow Jones,^RUT=Russell 2000,^NSEI=Nifty 50,^BSESN=Sensex,^FTSE=FTSE 100,^N225=Nikkei 225

# Email via Gmail SMTP (free). Needs a Google App Password: https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
# Where to send alerts (defaults to SMTP_USER)
EMAIL_TO=
