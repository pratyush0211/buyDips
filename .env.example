# Copy this file to .env for local development. Never commit .env.

# Database. Defaults to a local SQLite file; use your Supabase "Session pooler" string in production.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Long random value (32+ chars). Must be identical on the website and the scheduled job:
#   openssl rand -hex 32
SECRET_KEY=dev-only-change-me

# Public address used in emailed links (Render sets this automatically if unset).
BASE_URL=http://127.0.0.1:5000

# Email. "smtp" (Gmail etc.) or an HTTPS API: "resend" / "brevo".
# Hosts that block SMTP (like Render's free plan) need an API provider.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
MAIL_FROM=alerts@buydips.in

# Only for EMAIL_PROVIDER=smtp (Gmail needs an app password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Optional contact address shown in the footer and privacy page
CONTACT_EMAIL=
